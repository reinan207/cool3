-- ------------------------------------------------
-- getBestPC: retorna a lista de PCs ordenada do mais longe ao mais perto da Beast
--   (ignora os PCs já concluídos, de tela verde escura)
-- ------------------------------------------------
function getBestPC()
    local beast = getBeast()
    local pcs = {}
    local map = game.ReplicatedStorage.CurrentMap.Value
    if map ~= nil then
        for _,v in ipairs(map:getChildren()) do
            if v.Name == "ComputerTable" and v.Screen.BrickColor ~= BrickColor.new("Dark green") then
                -- distância entre o PC e a Beast
                local mag = (v.Screen.Position - beast.Character:findFirstChild("HumanoidRootPart").Position).magnitude
                table.insert(pcs, {magnitude=mag, pc=v})
            end
        end
    end
    -- ordena do mais longe para o mais perto
    table.sort(pcs, function(a, b) return a.magnitude > b.magnitude end)
    return pcs
end

