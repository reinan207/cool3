-- ------------------------------------------------
-- reloadESP: cria/remove os destaques (Highlight) conforme os toggles
--   - PCs (ComputerTable), Pods (FreezePod), Saídas (ExitDoor) e Jogadores
-- ------------------------------------------------
function reloadESP()
    spawn(function()
        local map = game.ReplicatedStorage.CurrentMap.Value  -- mapa atual
        if map ~= nil then
            local mapstuff = map:getChildren()
            for i=1,#mapstuff do
                -- ESP dos PCs
                if mapstuff[i].Name == "ComputerTable" then
                    -- remove o destaque se o toggle estiver desligado
                    if mapstuff[i]:findFirstChild("Highlight") and not pctoggle then
                        mapstuff[i].Highlight:remove()
                    end
                    -- cria o destaque se o toggle estiver ligado
                    if pctoggle and not mapstuff[i]:findFirstChild("Highlight") then
                        local a = Instance.new("Highlight", mapstuff[i])
                        a.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        local screen = mapstuff[i]:findFirstChild("Screen")
                        if screen then
                            -- usa a cor da tela do PC
                            a.FillColor = screen.Color
                            a.OutlineColor = Color3.fromRGB(a.FillColor.R*400, a.FillColor.G*400, a.FillColor.B*400)
                        else
                            -- cor padrão caso não ache a tela
                            a.FillColor = Color3.fromRGB(13, 105, 172)
                            a.OutlineColor = Color3.fromRGB(20, 165, 270)
                        end
                        -- loop que atualiza as cores do PC a cada 1s (e marca o melhor PC em roxo)
                        spawn(function()
                            repeat
                                if bestpctoggle and mapstuff[i]:findFirstChild("Screen") then
                                    if getBestPC()[1].pc ~= nil and mapstuff[i] == getBestPC()[1].pc then
                                        -- é o melhor PC: contorno roxo
                                        a.FillColor = mapstuff[i]:findFirstChild("Screen").Color
                                        a.OutlineColor = Color3.fromRGB(200, 0, 255)
                                    else
                                        a.FillColor = mapstuff[i]:findFirstChild("Screen").Color
                                        a.OutlineColor = Color3.fromRGB(a.FillColor.R*400, a.FillColor.G*400, a.FillColor.B*400)
                                    end
                                else
                                    a.FillColor = mapstuff[i]:findFirstChild("Screen").Color
                                    a.OutlineColor = Color3.fromRGB(a.FillColor.R*400, a.FillColor.G*400, a.FillColor.B*400)
                                end
                                wait(1)
                            until mapstuff[i] == nil or a == nil
                        end)
                    end
                end
                -- ESP das Pods (azul claro)
                if mapstuff[i].Name == "FreezePod" then
                    if mapstuff[i]:findFirstChild("Highlight") and not podstoggle then
                        mapstuff[i].Highlight:remove()
                    end
                    if podstoggle and not mapstuff[i]:findFirstChild("Highlight") then
                        local a = Instance.new("Highlight", mapstuff[i])
                        a.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        a.FillColor = Color3.fromRGB(120,200,255)
                        a.OutlineColor = Color3.fromRGB(160,255,255)
                    end
                end
                -- ESP das Saídas (amarelo)
                if mapstuff[i].Name == "ExitDoor" then
                    if mapstuff[i]:findFirstChild("Highlight") and not exitstoggle then
                        mapstuff[i].Highlight:remove()
                    end
                    if exitstoggle and not mapstuff[i]:findFirstChild("Highlight") then
                        local a = Instance.new("Highlight", mapstuff[i])
                        a.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        a.FillColor = Color3.fromRGB(252, 255, 100)
                        a.OutlineColor = Color3.fromRGB(255,255,160)
                    end
                end
            end
        end
    end)
    -- ESP dos Jogadores (verde; a Beast fica vermelha)
    local player = game.Players:GetChildren()
    for i=1, #player do
        if player[i] ~= game.Players.LocalPlayer and player[i].Character ~= nil then
            local character = player[i].Character
            -- remove o destaque se o toggle estiver desligado
            if character:findFirstChild("Highlight") and not playertoggle then
                character.Highlight:remove()
            end
            -- cria o destaque se o toggle estiver ligado
            if playertoggle and not character:findFirstChild("Highlight") then
                local a = Instance.new("Highlight", character)
                a.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                a.FillColor = Color3.fromRGB(0,255,0)
                a.OutlineColor = Color3.fromRGB(127,255,127)
                -- loop que troca a cor para vermelho se o jogador for a Beast
                spawn(function()
                    repeat
                        wait(0.1)
                        if player[i] == getBeast() then
                            a.FillColor = Color3.fromRGB(255,0,0)
                            a.OutlineColor = Color3.fromRGB(255,127,127)
                        else
                            a.FillColor = Color3.fromRGB(0,255,0)
                            a.OutlineColor = Color3.fromRGB(127,255,127)
                        end
                    until character == nil or a == nil
                end)
            end
        end
    end
end

-- ------------------------------------------------
-- reloadBeastCam: monta a câmera que mostra a visão da Beast
--   (clona o mapa e os jogadores dentro do ViewportFrame)
-- ------------------------------------------------
function reloadBeastCam()
    ViewportFrame:ClearAllChildren()
    if beastcamtoggle and game.ReplicatedStorage.CurrentMap.Value ~= nil then
        local beast = getBeast()
        -- câmera usada dentro do ViewportFrame
        local cam = Instance.new("Camera", ScreenGui)
        cam.CameraType = Enum.CameraType.Scriptable
        cam.FieldOfView = 70
        -- clona o mapa para mostrar dentro do quadro
        local map = game.ReplicatedStorage.CurrentMap.Value
        local mapclone = map:clone()
        mapclone.Name = "map"
        -- remove portas, sons e scripts do clone
        local mcstuff = mapclone:getDescendants()
        for i=1,#mcstuff do
            if mcstuff[i].Name == "SingleDoor" or mcstuff[i].Name == "DoubleDoor" or mcstuff[i].ClassName == "Sound" or mcstuff[i].ClassName == "LocalScript" or mcstuff[i].ClassName == "Script" then
                mcstuff[i]:remove()
            end
        end
        mapclone.Parent = ViewportFrame
        ViewportFrame.CurrentCamera = cam
        -- loop que move a câmera para a cabeça da Beast
        spawn(function()
            repeat
                wait()
                if not beastcamtoggle then break end
                repeat wait() until getBeast().Character ~= nil
                cam.CFrame = getBeast().Character.Head.CFrame
                wait()
            until cam == nil or mapclone == nil or beast ~= getBeast()
        end)
        -- loop que atualiza as portas e os jogadores (clones) dentro do quadro
        spawn(function()
            local dummy = Instance.new("Folder", ViewportFrame)    -- pasta dos jogadores clonados
            dummy.Name = "dummy"
            local doors = Instance.new("Folder", ViewportFrame)    -- pasta das portas clonadas
            doors.Name = "doors"
            repeat
                wait()
                if not beastcamtoggle then break end
                -- clona as portas atuais
                local doorsstuff = map:GetChildren()
                for i=1,#doorsstuff do
                    if doorsstuff[i].Name == "SingleDoor" or doorsstuff[i].Name == "DoubleDoor" then
                        doorsstuff[i]:clone().Parent = doors
                    end
                end
                -- clona os jogadores (menos a Beast)
                local players = game.Players:getChildren()
                for i=1,#players do
                    if players[i] ~= getBeast() and players[i].Character ~= nil then
                        players[i].Character.Archivable = true
                        local dummyclone = players[i].Character:clone()
                        for _,v in ipairs(dummyclone:getDescendants()) do
                            if v.ClassName == "Sound" or v.ClassName == "LocalScript" or v.ClassName == "Script" then v:remove() end
                        end
                        dummyclone.Parent = dummy
                    end
                end
                wait(0.3)
                -- limpa os clones para recriar no próximo ciclo
                dummy:ClearAllChildren()
                doors:ClearAllChildren()
            until cam == nil or mapclone == nil or beast ~= getBeast()
        end)
    end
end

-- ------------------------------------------------
-- getBeast: retorna o jogador que é a Beast
-- ------------------------------------------------
function getBeast()
    for _, p in ipairs(game.Players:GetPlayers()) do
        local stats = p:FindFirstChild("TempPlayerStatsModule")
        local isBeast = stats and stats:FindFirstChild("IsBeast")
        local char = p.Character
        if (isBeast and isBeast.Value == true) or (char and char:FindFirstChild("BeastPowers")) then
            return p
        end
    end
    return nil
end

function getBestPC()
    local beast = getBeast()
    local pcs = {}
    local map = game.ReplicatedStorage.CurrentMap.Value
    local beastRoot = beast and beast.Character and beast.Character:FindFirstChild("HumanoidRootPart")
    if map ~= nil and beastRoot then
        for _, v in ipairs(map:GetChildren()) do
            local screen = v.Name == "ComputerTable" and v:FindFirstChild("Screen")
            if screen and screen.BrickColor ~= BrickColor.new("Dark green") then
                local mag = (screen.Position - beastRoot.Position).Magnitude
                table.insert(pcs, {magnitude = mag, pc = v})
            end
        end
    end
    table.sort(pcs, function(a, b) return a.magnitude > b.magnitude end)
    return pcs
end

-- cria, atualiza ou remove o Highlight de um objeto
local function setHighlight(obj, enabled, fill, outline)
    local h = obj:FindFirstChild("ESPHighlight")
    if not enabled then
        if h then h:Destroy() end
        return
    end
    if not h then
        h = Instance.new("Highlight")
        h.Name = "ESPHighlight"
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = obj
    end
    h.FillColor = fill
    h.OutlineColor = outline
end

function reloadESP()
    local map = game.ReplicatedStorage.CurrentMap.Value
    if map ~= nil then
        local bestPC = nil
        if pctoggle and bestpctoggle then
            local list = getBestPC()
            bestPC = list[1] and list[1].pc
        end
        for _, obj in ipairs(map:GetChildren()) do
            pcall(function()
                if obj.Name == "ComputerTable" then
                    local screen = obj:FindFirstChild("Screen")
                    local fill = Color3.fromRGB(13, 105, 172)
                    local outline = Color3.fromRGB(20, 165, 255)
                    if screen then
                        fill = screen.Color
                        outline = Color3.fromRGB(math.min(255, fill.R * 400), math.min(255, fill.G * 400), math.min(255, fill.B * 400))
                    end
                    if obj == bestPC then outline = Color3.fromRGB(200, 0, 255) end
                    setHighlight(obj, pctoggle, fill, outline)
                elseif obj.Name == "FreezePod" then
                    setHighlight(obj, podstoggle, Color3.fromRGB(120, 200, 255), Color3.fromRGB(160, 255, 255))
                elseif obj.Name == "ExitDoor" then
                    setHighlight(obj, exitstoggle, Color3.fromRGB(252, 255, 100), Color3.fromRGB(255, 255, 160))
                end
            end)
        end
    end

    local beast = getBeast()
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= game.Players.LocalPlayer and p.Character then
            pcall(function()
                if p == beast then
                    setHighlight(p.Character, playertoggle, Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 127, 127))
                else
                    setHighlight(p.Character, playertoggle, Color3.fromRGB(0, 255, 0), Color3.fromRGB(127, 255, 127))
                end
            end)
        end
    end
end

