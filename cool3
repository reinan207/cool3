-- ================================================
-- ANTI-VOID
-- (impede cair no vazio: cria um chão falso e teleporta de volta se cair)
-- ================================================
local antiVoidEnabled = true         -- anti-void começa ligado
local lastSafePosition = nil         -- última posição com chão de verdade embaixo
local antiVoidConnection = nil       -- conexão do loop do anti-void
local fakePlatform = nil             -- peça invisível usada como chão falso
local fakePlatformY = nil            -- altura fixa do chão falso

-- Remove o chão falso (se existir)
local function removeFakePlatform()
    if fakePlatform and fakePlatform.Parent then
        local old = fakePlatform
        fakePlatform = nil
        fakePlatformY = nil
        old:Destroy()
    end
end

-- Cria o chão falso invisível na altura informada, embaixo do personagem
local function createFakePlatform(atY)
    removeFakePlatform()
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    fakePlatformY = atY
    fakePlatform = Instance.new("Part")
    fakePlatform.Name = "FakeFloor"
    fakePlatform.Size = Vector3.new(200, 1, 200)
    fakePlatform.Anchored = true
    fakePlatform.CanCollide = true
    fakePlatform.Transparency = 1
    fakePlatform.CFrame = CFrame.new(root.Position.X, fakePlatformY, root.Position.Z)
    fakePlatform.Parent = workspace
end

-- Lança um raio para baixo e verifica se existe chão real embaixo da posição
local function hasRealFloorBelow(position)
    local rayOrigin = position
    local rayDirection = Vector3.new(0, -20, 0)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    local character = game.Players.LocalPlayer.Character
    local excluded = {}
    -- ignora o próprio personagem no raio
    if character then
        for _, d in ipairs(character:GetDescendants()) do
            table.insert(excluded, d)
        end
        table.insert(excluded, character)
    end
    -- ignora o chão falso no raio
    if fakePlatform then table.insert(excluded, fakePlatform) end
    raycastParams.FilterDescendantsInstances = excluded

    local result = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
    if result and result.Instance:IsA("BasePart") then
        -- Se noclip está ativo, ignora o CanCollide e considera o chão como válido
        if noclipEnabled or result.Instance.CanCollide then
            return true, result.Position.Y
        end
    end
    return false, nil
end

-- Inicia o loop do anti-void (roda todo frame)
local function startAntiVoid()
    -- evita conexões duplicadas
    if antiVoidConnection then
        antiVoidConnection:Disconnect()
        antiVoidConnection = nil
    end

    antiVoidConnection = RunService.Heartbeat:Connect(function()
        if scriptKilled then return end
        if not antiVoidEnabled then return end

        local character = game.Players.LocalPlayer.Character
        if not character then return end
        local root = character:FindFirstChild("HumanoidRootPart")
        local hum = character:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        local pos = root.Position

        -- Caiu no void real
        -- (abaixo de Y = -100: teleporta de volta para a última posição segura)
        if pos.Y < -100 and lastSafePosition then
            removeFakePlatform()
            root.CFrame = CFrame.new(lastSafePosition + Vector3.new(0, 3, 0))
            root.Velocity = Vector3.zero
            root.AssemblyLinearVelocity = Vector3.zero
            return
        end

        local hasFloor, floorY = hasRealFloorBelow(pos)

        if hasFloor then
            -- tem chão real: salva a posição como segura e remove o chão falso
            lastSafePosition = pos
            removeFakePlatform()
        else
            -- sem chão real: cria/mantém o chão falso embaixo do personagem
            if not fakePlatform or not fakePlatform.Parent then
                -- Cria a plataforma na altura atual dos pés do personagem
                createFakePlatform(pos.Y - 3)
            else
                -- Só move X e Z, NUNCA muda o Y (evita empurrar o boneco)
                fakePlatform.CFrame = CFrame.new(
                    pos.X,
                    fakePlatformY, -- altura fixa!
                    pos.Z
                )
            end
        end
    end)
end

startAntiVoid() -- liga o anti-void assim que o script carrega

-- Ao respawnar: limpa a posição segura e reinicia o anti-void
game.Players.LocalPlayer.CharacterAdded:Connect(function()
    lastSafePosition = nil
    removeFakePlatform()
    wait(1)
    startAntiVoid()
end)
-- ================================================
-- FLY STATE
-- (voar com WASD, Q/E ou Espaço, e Shift para turbo)
-- ================================================
local flyEnabled = false             -- fly ligado/desligado
local flyBodyVelocity = nil          -- objeto que move o personagem
local flyBodyGyro = nil              -- objeto que gira o personagem para a direção da câmera
local flyConnection = nil            -- conexão do loop do fly

-- Liga (on = true) ou desliga (on = false) o fly
local function setFly(on)
    flyEnabled = on
    -- limpa tudo que existia antes
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
    if flyBodyGyro then flyBodyGyro:Destroy(); flyBodyGyro = nil end

    local character = game.Players.LocalPlayer.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not root then return end

    if on then
        if hum then hum.PlatformStand = true end
        -- BodyVelocity: controla a velocidade do voo
        flyBodyVelocity = Instance.new("BodyVelocity")
        flyBodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        flyBodyVelocity.Velocity = Vector3.zero
        flyBodyVelocity.Parent = root

        -- BodyGyro: mantém o personagem virado para onde a câmera olha
        flyBodyGyro = Instance.new("BodyGyro")
        flyBodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        flyBodyGyro.P = 9e3
        flyBodyGyro.D = 80
        flyBodyGyro.CFrame = root.CFrame
        flyBodyGyro.Parent = root

        -- Loop do fly: lê as teclas e define a direção/velocidade
        flyConnection = RunService.Heartbeat:Connect(function()
            if not flyBodyVelocity or not flyBodyVelocity.Parent then return end
            local cam = workspace.CurrentCamera
            local spd = 40 -- velocidade base do fly
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then spd = spd * 4.5 end -- turbo com Shift
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end   -- frente
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end   -- trás
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end  -- esquerda
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end  -- direita
            if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end -- subir
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) then dir -= Vector3.yAxis end           -- descer
            flyBodyVelocity.Velocity = dir.Magnitude > 0 and dir.Unit * spd or Vector3.zero
            flyBodyGyro.CFrame = cam.CFrame
        end)
    else
        -- desligando: devolve o controle normal ao personagem
        if hum then hum.PlatformStand = false end
    end
end

-- Ao respawnar: desliga o fly e deixa o botão vermelho
game.Players.LocalPlayer.CharacterAdded:Connect(function()
