-- ================================================
-- DRAG ICONE
-- (arrastar o ícone do menu; se só clicar sem arrastar, abre/fecha o menu)
-- ================================================
do
    local UIS = game:GetService("UserInputService")
    local dragging = false   -- está com o mouse pressionado no ícone
    local dragged = false    -- o mouse se moveu (foi arraste, não clique)
    local dragStart
    local startPos

    -- Começou a pressionar o ícone
    CheatButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragged = false
            dragStart = UIS:GetMouseLocation()
            startPos = MenusTabFrame.Position
        end
    end)

    -- Moveu o mouse enquanto pressionava: move o ícone
    CheatButton.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            dragged = true
            local mousePos = UIS:GetMouseLocation()
            local delta = mousePos - dragStart
            MenusTabFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    -- Soltou o mouse: se não arrastou, conta como clique e abre/fecha o menu
    CheatButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            if not dragged then
                ESPMenuWindow.Visible = false
                ToolsMenuWindow.Visible = false
                MainMenuWindow.Visible = not MainMenuWindow.Visible
            end
            dragged = false
        end
    end)
end

