-- ================================================
-- AUTO-PLAY
-- (a cada 3s, anda sozinho até os PCs usando pathfinding)
-- ================================================
spawn(function()
    while wait(3) do
        if scriptKilled then break end
        if autoplaytoggle then
            local beast = getBeast()
            local map = game.ReplicatedStorage.CurrentMap.Value
            local mapstuff = map:getChildren()
            -- configura as portas para o pathfinding (atravessa as portas e evita os batentes)
            for i=1,#mapstuff do
                if mapstuff[i].Name == "SingleDoor" or mapstuff[i].Name == "DoubleDoor" then
                    for _,dp in ipairs(mapstuff[i]:getDescendants()) do
                        if dp.ClassName == "Part" and dp.Name ~= "Frame" then
                            if not dp:findFirstChild("PathfindingModifier") then
                                local a = Instance.new("PathfindingModifier", dp)
                                a.PassThrough = true
                            end
                        end
                        if dp.Name == "Frame" then
                            local a = Instance.new("PathfindingModifier", dp)
                            a.PassThrough = false
                            a.Label = "avoid"
                        end
                    end
                end
            end
            local pcs = getBestPC()   -- lista de PCs ordenada
            local PathfindingService = game:GetService("PathfindingService")
            local Humanoid = game.Players.LocalPlayer.Character:WaitForChild("Humanoid")
            local Root = game.Players.LocalPlayer.Character:WaitForChild("HumanoidRootPart")
            -- parâmetros do pathfinding (tamanho do agente e custo de evitar certas áreas)
            local agentParams = {
                AgentRadius = 2.4, AgentHeight = 2, AgentCanJump = true,
                AgentWalkableClimb = 4, WaypointSpacing = 2,
                Costs = { avoid = 10.0 }
            }
            -- true se a Beast está a menos de 50 studs de distância
            local beastNearby = ((game.Players.LocalPlayer.Character.HumanoidRootPart.Position - beast.Character:findFirstChild("HumanoidRootPart").Position).magnitude < 50)
            for i, pc in ipairs(pcs) do
                -- se já está digitando e a Beast não está perto, para de procurar
                if isPlayerTyping() and not beastNearby then break end
                local goal = pc.pc["ComputerTrigger1"].Position   -- ponto de ativação do PC
                local path = PathfindingService:CreatePath(agentParams)
                path:ComputeAsync(Root.Position, goal)
                if path.Status == Enum.PathStatus.Success then
                    -- percorre cada ponto do caminho
                    for _, waypoint in ipairs(path:GetWaypoints()) do
                        Humanoid:MoveTo(waypoint.Position)
                        if waypoint.Action == Enum.PathWaypointAction.Jump then
                            Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                        end
                        -- bolinha rosa que marca o ponto do caminho
                        local a = Instance.new("Part", workspace)
                        a.Shape = Enum.PartType.Ball
                        a.Position = waypoint.Position
                        a.BrickColor = BrickColor.new("Pink")
                        a.Material = Enum.Material.Neon
                        a.Size = Vector3.new(2,2,2)
                        a.Anchored = true
                        a.CanCollide = false
                        local touch = false
                        -- some quando o jogador encosta nela (ou após 10s)
                        spawn(function()
                            a.Touched:Connect(function(hit)
                                if hit.Parent:FindFirstChild("Humanoid") and hit.Parent.Name == game.Players.LocalPlayer.Character.Name then
                                    touch = true; a:remove()
                                end
                            end)
                            wait(10); a:remove()
                        end)
                        -- espera até chegar no ponto antes de ir para o próximo
                        repeat wait(0.05) until touch
                    end
                    break
                end
            end
        end
    end
end)
