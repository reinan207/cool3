-- ================================================
-- NOCLIP STATE
-- (atravessar paredes desligando a colisão do personagem)
-- ================================================
local noclipEnabled = false          -- noclip ligado/desligado
local noclipConnection = nil         -- conexão do loop do noclip
local noclipOriginalCollide = {}     -- guarda o CanCollide original de cada parte

-- Salva o estado de colisão original de todas as partes do personagem
local function saveCollideState()
    noclipOriginalCollide = {}
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            noclipOriginalCollide[part] = part.CanCollide
        end
    end
end

-- Restaura a colisão original salva
local function restoreCollideState()
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            local original = noclipOriginalCollide[part]
            if original ~= nil then
                part.CanCollide = original
            end
        end
    end
    noclipOriginalCollide = {}
end

-- Liga (on = true) ou desliga (on = false) o noclip
local function setNoclip(on)
    noclipEnabled = on
    if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
    if on then
        saveCollideState()
        -- a cada passo da física, força CanCollide = false em todas as partes
        noclipConnection = RunService.Stepped:Connect(function()
            local char = game.Players.LocalPlayer.Character
            if not char then return end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
    else
        restoreCollideState()
    end
end

-- Ao respawnar: desliga o noclip e deixa o botão vermelho
game.Players.LocalPlayer.CharacterAdded:Connect(function()
    noclipEnabled = false
    noclipOriginalCollide = {}
    if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
    if NoclipButton then
        NoclipButton.BackgroundColor3 = Color3.new(0.74902, 0, 0)
    end
end)

