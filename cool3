--
function restartPCESP()
    spawn(function()
        local map = game.ReplicatedStorage.CurrentMap.Value
        if map == nil then return end

        -- espera os PCs (e a Screen de cada um) existirem, até 20s
        local t = 0
        local ready = false
        repeat
            local count, withScreen = 0, 0
            for _, v in ipairs(map:GetChildren()) do
                if v.Name == "ComputerTable" then
                    count = count + 1
                    if v:FindFirstChild("Screen") then withScreen = withScreen + 1 end
                end
            end
            ready = count > 0 and count == withScreen
            if not ready then wait(0.05); t = t + 0.05 end
        until ready or t > 20 or map ~= game.ReplicatedStorage.CurrentMap.Value

        if map ~= game.ReplicatedStorage.CurrentMap.Value then return end

        -- remove os destaques antigos dos PCs
        for _, v in ipairs(map:GetChildren()) do
            if v.Name == "ComputerTable" then
                local h = v:FindFirstChild("ESPHighlight")
                if h then h:Destroy() end
            end
        end
        wait(0.1)
        reloadESP()
    end)
end
